# Copier en .env (jamais versionné) et adapter.
DATABASE_URL=postgres://cortege:changez-moi@localhost:5432/cortege
POSTGRES_PASSWORD=changez-moi
# Base utilisée par les tests (réinitialisée à chaque exécution !)
TEST_DATABASE_URL=postgres://cortege:cortege@localhost:5432/cortege_test
PORT=3000
HOST=127.0.0.1
# true en production (HTTPS obligatoire)
COOKIE_SECURE=false
SESSION_TTL_HOURS=12
# Instance Overpass : préférer une instance auto-hébergée pour un usage régulier
# Plusieurs serveurs possibles, séparés par des virgules (essayés dans l'ordre)
OVERPASS_URL=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter
OSM_USER_AGENT=cortege-coordination (contact: admin@example.org)
# Fond de carte (interface) : respecter la politique d'usage du fournisseur
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Photos de rue Panoramax (interface)
VITE_PANORAMAX_URL=https://api.panoramax.xyz/api
# Fond « Satellite » : autre fournisseur (modèle {z}/{x}/{y}) et son attribution
# VITE_SATELLITE_URL=
# VITE_SATELLITE_ATTRIBUTION=

# Adresse publique du site (utilisée dans la configuration envoyée à l'application OwnTracks).
# PUBLIC_URL=https://cortege.example.org

# Liens de connexion par e-mail (facultatif).
# SMTP_URL=smtps://utilisateur:motdepasse@smtp.example.org:465
# MAIL_FROM=Coordination de cortège <no-reply@example.org>
